{
  "manifest_version": 3,
  "name": "AI Eraser",
  "version": "1.1.0",
  "description": "Conservatively flags posts with explicit AI disclosures and lets you correct the results.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.linkedin.com/*",
        "*://*.reddit.com/*",
        "*://*.youtube.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI Eraser feedback",
    "default_popup": "popup.html"
  }
}
